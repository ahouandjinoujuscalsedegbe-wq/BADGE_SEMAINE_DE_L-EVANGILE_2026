     // Rendu sur tampon 2160 x 2160 px avec ctx.setTransform(2, 0, 0, 2, 0, 0) sur coordonnées 1080 x 1080 px
     function renderBadge() {
       if (!canvas) return;

       let ctx = null;
       try {
         ctx = canvas.getContext('2d');
       } catch (_) {
         ctx = null;
       }
       if (!ctx) return;

       try {
         if (canvas.width !== TARGET_INTERNAL_SIZE) {
           canvas.width = TARGET_INTERNAL_SIZE;
         }
         if (canvas.height !== TARGET_INTERNAL_SIZE) {
           canvas.height = TARGET_INTERNAL_SIZE;
         }
       } catch (_) {
         // Conserver les dimensions existantes si nécessaire
       }

       const scale = canvas.width === TARGET_INTERNAL_SIZE ? SUPERSAMPLE_SCALE : (canvas.width > 0 ? canvas.width / LOGICAL_SIZE : SUPERSAMPLE_SCALE);

       try {
         ctx.setTransform(scale, 0, 0, scale, 0, 0);
       } catch (_) {
         try {
           ctx.resetTransform();
           ctx.scale(scale, scale);
         } catch (__) {
           // Ignorer
         }
       }

       try {
         ctx.imageSmoothingEnabled = true;
         ctx.imageSmoothingQuality = 'high';
       } catch (_) {
         // Ignorer
       }

       try {
         drawBackgroundAndFrame(ctx);
         drawCuaPlaque(ctx, (LOGICAL_SIZE - 420) / 2, 48, 420, 98, 22);
         drawEventPill(ctx);
         drawPhotoFrame(ctx);
         drawRightColumn(ctx);
         drawLowerSection(ctx);
       } catch (_) {
         drawFallbackBadge(ctx);
       }
     }

     function handlePhotoFile(file) {
       if (!file) return;
       if (file.type && !file.type.startsWith('image/')) {
         state.customStatusError = 'Veuillez sélectionner un fichier image valide (JPG, PNG, WEBP).';
         syncUiState();
         return;
       }

       state.customStatusError = '';

       const applyLoadedImage = function (img) {
         state.photoImg = img;
         state.photoLoaded = true;
         state.zoom = 1;
         state.offsetX = 0;
         state.offsetY = 0;

         if (photoFileName) {
           photoFileName.textContent = file.name || 'Photo chargée';
         }
         if (photoStatusRow) {
           photoStatusRow.classList.add('visible');
         }
         syncUiState();
         renderBadge();
       };

       try {
         const reader = new FileReader();
         reader.onload = function (evt) {
           const img = new Image();
           img.onload = function () {
             applyLoadedImage(img);
           };
           img.onerror = function () {
             state.customStatusError = 'Impossible de lire cette image.';
             syncUiState();
           };
           img.src = String(evt && evt.target && evt.target.result ? evt.target.result : '');
         };
         reader.onerror = function () {
           state.customStatusError = 'Erreur lors du chargement de la photo.';
           syncUiState();
         };
         reader.readAsDataURL(file);
       } catch (_) {
         try {
           const objectUrl = URL.createObjectURL(file);
           const img = new Image();
           img.onload = function () {
             applyLoadedImage(img);
             setTimeout(function () {
               try {
                 URL.revokeObjectURL(objectUrl);
               } catch (__) {
                 // Ignorer
               }
             }, 2000);
           };
           img.onerror = function () {
             state.customStatusError = 'Impossible de charger la photo.';
             syncUiState();
           };
           img.src = objectUrl;
         } catch (__) {
           state.customStatusError = 'Chargement photo indisponible sur cet appareil.';
           syncUiState();
         }
       }
     }

     function clearPhoto() {
       state.photoImg = null;
       state.photoLoaded = false;
       state.zoom = 1;
       state.offsetX = 0;
       state.offsetY = 0;
       state.customStatusError = '';
       if (photoFileInput) photoFileInput.value = '';
       if (photoStatusRow) photoStatusRow.classList.remove('visible');
       syncUiState();
       renderBadge();
     }

     function setZoom(nextZoom) {
       if (!state.photoLoaded) return;
       state.zoom = clamp(Number(nextZoom.toFixed(2)), ZOOM_MIN, ZOOM_MAX);
       updateZoomReadout();
       renderBadge();
     }

     function resetCrop() {
       if (!state.photoLoaded) return;
       state.zoom = 1;
       state.offsetX = 0;
       state.offsetY = 0;
       updateZoomReadout();
       renderBadge();
     }

     function clientToBadgeCoords(clientX, clientY) {
       if (!canvasFrameBox) return { x: 0, y: 0 };
       const rect = canvasFrameBox.getBoundingClientRect();
       if (!rect.width || !rect.height) return { x: 0, y: 0 };
       return {
         x: ((clientX - rect.left) / rect.width) * LOGICAL_SIZE,
         y: ((clientY - rect.top) / rect.height) * LOGICAL_SIZE
       };
     }

     function isInsidePhotoBox(bx, by) {
       return (
         bx >= PHOTO_BOX.x &&
         bx <= PHOTO_BOX.x + PHOTO_BOX.size &&
         by >= PHOTO_BOX.y &&
         by <= PHOTO_BOX.y + PHOTO_BOX.size
       );
     }

     function getTouchDistance(t1, t2) {
       return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
     }

     if (canvasFrameBox) {
       canvasFrameBox.addEventListener('mousedown', function (e) {
         if (!state.photoLoaded || e.button !== 0) return;
         const pt = clientToBadgeCoords(e.clientX, e.clientY);
         if (!isInsidePhotoBox(pt.x, pt.y)) return;

         state.dragging = true;
         state.dragStartX = pt.x - state.offsetX;
         state.dragStartY = pt.y - state.offsetY;
         canvasFrameBox.classList.add('is-dragging');
       });

       window.addEventListener('mousemove', function (e) {
         if (!state.dragging || !state.photoLoaded) return;
         const pt = clientToBadgeCoords(e.clientX, e.clientY);
         state.offsetX = clamp(pt.x - state.dragStartX, -550, 550);
         state.offsetY = clamp(pt.y - state.dragStartY, -550, 550);
         renderBadge();
       });

       window.addEventListener('mouseup', function () {
         if (state.dragging) {
           state.dragging = false;
           canvasFrameBox.classList.remove('is-dragging');
         }
       });

       canvasFrameBox.addEventListener('wheel', function (e) {
         if (!state.photoLoaded) return;
         const pt = clientToBadgeCoords(e.clientX, e.clientY);
         if (!isInsidePhotoBox(pt.x, pt.y)) return;
         e.preventDefault();
         setZoom(state.zoom + (e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP));
       }, { passive: false });

       canvasFrameBox.addEventListener('touchstart', function (e) {
         if (!state.photoLoaded) return;

         if (e.touches.length === 2) {
           state.dragging = false;
           state.pinchStartDist = getTouchDistance(e.touches[0], e.touches[1]);
           state.pinchStartZoom = state.zoom;
           e.preventDefault();
           return;
         }

         if (e.touches.length === 1) {
           const t = e.touches[0];
           const pt = clientToBadgeCoords(t.clientX, t.clientY);
           if (!isInsidePhotoBox(pt.x, pt.y)) return;
           state.dragging = true;
           state.dragStartX = pt.x - state.offsetX;
           state.dragStartY = pt.y - state.offsetY;
           canvasFrameBox.classList.add('is-dragging');
           e.preventDefault();
         }
       }, { passive: false });

       canvasFrameBox.addEventListener('touchmove', function (e) {
         if (!state.photoLoaded) return;

         if (e.touches.length === 2 && state.pinchStartDist > 0) {
           const dist = getTouchDistance(e.touches[0], e.touches[1]);
           setZoom(state.pinchStartZoom * (dist / state.pinchStartDist));
           e.preventDefault();
           return;
         }

         if (e.touches.length === 1 && state.dragging) {
           const t = e.touches[0];
           const pt = clientToBadgeCoords(t.clientX, t.clientY);
           state.offsetX = clamp(pt.x - state.dragStartX, -550, 550);
           state.offsetY = clamp(pt.y - state.dragStartY, -550, 550);
           renderBadge();
           e.preventDefault();
         }
       }, { passive: false });

       canvasFrameBox.addEventListener('touchend', function (e) {
         if (e.touches.length < 2) {
           state.pinchStartDist = 0;
         }
         if (e.touches.length === 0) {
           state.dragging = false;
           canvasFrameBox.classList.remove('is-dragging');
         }
       });
     }

     function bindHoldZoom(btn, delta) {
       if (!btn) return;
       const stopHold = function () {
         if (state.holdTimer) {
           clearTimeout(state.holdTimer);
           state.holdTimer = null;
         }
         if (state.holdInterval) {
           clearInterval(state.holdInterval);
           state.holdInterval = null;
         }
       };

       btn.addEventListener('click', function () {
         setZoom(state.zoom + delta);
       });

       btn.addEventListener('mousedown', function () {
         stopHold();
         state.holdTimer = setTimeout(function () {
           state.holdInterval = setInterval(function () {
             setZoom(state.zoom + delta * 0.5);
           }, 80);
         }, 260);
       });

       btn.addEventListener('touchstart', function () {
         stopHold();
         state.holdTimer = setTimeout(function () {
           state.holdInterval = setInterval(function () {
             setZoom(state.zoom + delta * 0.5);
           }, 80);
         }, 260);
       }, { passive: true });

       ['mouseup', 'mouseleave', 'touchend', 'touchcancel'].forEach(function (ev) {
         btn.addEventListener(ev, stopHold);
       });
     }

     bindHoldZoom(zoomOutBtn, -ZOOM_STEP);
     bindHoldZoom(zoomInBtn, ZOOM_STEP);

     if (resetCropBtn) {
       resetCropBtn.addEventListener('click', resetCrop);
     }

     function canvasToBlob() {
       return new Promise(function (resolve, reject) {
         renderBadge();
         if (!canvas || typeof canvas.toBlob !== 'function') {
           reject(new Error('Export indisponible'));
           return;
         }
         canvas.toBlob(function (blob) {
           if (blob) {
             resolve(blob);
           } else {
             reject(new Error('Échec de génération du PNG'));
           }
         }, 'image/png', 1);
       });
     }

     function buildFileName() {
       const slug = getCleanName()
         .toLowerCase()
         .normalize('NFD')
         .replace(/[\u0300-\u036f]/g, '')
         .replace(/[^a-z0-9]+/g, '-')
         .replace(/^-+|-+$/g, '');
       return `badge-cua-${slug || 'membre'}-1080x1080.png`;
     }

     function buildWhatsAppCaption() {
       const cleanName = getCleanName();
       return (
         `J'Y SERAI ! — ${cleanName}\n` +
         `Pour prêcher et gagner des âmes à Christ\n` +
         `Semaine de l'Évangile • Centre Universitaire Apostolique (CUA)\n` +
         `${BADGE_COPY.dateText} • ${BADGE_COPY.placeText}\n` +
         `${BADGE_COPY.timeText}\n` +
         `Gagner des âmes • Ensemble pour Christ`
       );
     }

     async function triggerDownload() {
       if (!validateMandatoryFields()) return;
       try {
         const blob = await canvasToBlob();
         const url = URL.createObjectURL(blob);
         const link = document.createElement('a');
         link.href = url;
         link.download = buildFileName();
         document.body.appendChild(link);
         link.click();
         document.body.removeChild(link);
         setTimeout(function () {
           URL.revokeObjectURL(url);
         }, 2500);
         state.customStatusError = '';
         syncUiState();
       } catch (_) {
         state.customStatusError = 'Impossible de télécharger le badge pour le moment.';
         syncUiState();
       }
     }

     function openWhatsAppModal(caption) {
       if (whatsappCaptionBox) {
         whatsappCaptionBox.value = caption;
       }
       if (whatsappModal) {
         whatsappModal.classList.add('open');
       }
     }

     async function shareToWhatsAppStatus() {
       if (!validateMandatoryFields()) return;

       const caption = buildWhatsAppCaption();
       const fileName = buildFileName();

       try {
         const blob = await canvasToBlob();
         const file = new File([blob], fileName, { type: 'image/png' });

         if (
           typeof navigator !== 'undefined' &&
           typeof navigator.share === 'function' &&
           (!navigator.canShare || navigator.canShare({ files: [file] }))
         ) {
           await navigator.share({
             title: "Badge Semaine de l'Évangile — CUA",
             text: caption,
             files: [file]
           });
           state.customStatusError = '';
           syncUiState();
           return;
         }

         const url = URL.createObjectURL(blob);
         const link = document.createElement('a');
         link.href = url;
         link.download = fileName;
         document.body.appendChild(link);
         link.click();
         document.body.removeChild(link);
         setTimeout(function () {
           URL.revokeObjectURL(url);
         }, 2500);

         if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
           try {
             await navigator.clipboard.writeText(caption);
           } catch (_) {
             // Ignorer
           }
         }
         openWhatsAppModal(caption);
       } catch (err) {
         if (err && err.name === 'AbortError') {
           state.customStatusError = '';
           syncUiState();
           return;
         }
         openWhatsAppModal(caption);
       }
     }

     if (fullNameInput) {
       fullNameInput.addEventListener('input', function () {
         state.fullName = fullNameInput.value;
         state.customStatusError = '';
         syncUiState();
         renderBadge();
       });
     }

     if (photoFileInput) {
       photoFileInput.addEventListener('change', function () {
         const f = photoFileInput.files && photoFileInput.files[0];
         if (f) handlePhotoFile(f);
       });
     }

     if (dropzone) {
       dropzone.addEventListener('dragover', function (e) {
         e.preventDefault();
         dropzone.classList.add('dragover');
       });
       dropzone.addEventListener('dragleave', function () {
         dropzone.classList.remove('dragover');
       });
       dropzone.addEventListener('drop', function (e) {
         e.preventDefault();
         dropzone.classList.remove('dragover');
         const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
         if (f) handlePhotoFile(f);
       });
     }

     if (clearPhotoBtn) {
       clearPhotoBtn.addEventListener('click', clearPhoto);
     }

     if (whatsappShareBtn) {
       whatsappShareBtn.addEventListener('click', shareToWhatsAppStatus);
     }

     if (downloadPngBtn) {
       downloadPngBtn.addEventListener('click', triggerDownload);
     }

     if (copyCaptionBtn) {
       copyCaptionBtn.addEventListener('click', function () {
         if (!whatsappCaptionBox) return;
         whatsappCaptionBox.focus();
         whatsappCaptionBox.select();
         try {
           document.execCommand('copy');
           copyCaptionBtn.textContent = 'Copié !';
           setTimeout(function () {
             copyCaptionBtn.textContent = 'Copier le texte';
           }, 1800);
         } catch (_) {
           // Ignorer
         }
       });
     }

     if (closeModalBtn && whatsappModal) {
       closeModalBtn.addEventListener('click', function () {
         whatsappModal.classList.remove('open');
       });
       whatsappModal.addEventListener('click', function (e) {
         if (e.target === whatsappModal) {
           whatsappModal.classList.remove('open');
         }
       });
     }

     function refreshBadgeAndUi() {
       syncUiState();
       renderBadge();
     }

     // Déclenchement immédiat, via requestAnimationFrame, DOM prêt, load, polices et ResizeObserver
     refreshBadgeAndUi();

     if (typeof requestAnimationFrame === 'function') {
       requestAnimationFrame(refreshBadgeAndUi);
     }

     if (document.readyState === 'loading') {
       document.addEventListener('DOMContentLoaded', refreshBadgeAndUi, { once: true });
     }

     window.addEventListener('load', refreshBadgeAndUi);
     window.addEventListener('resize', refreshBadgeAndUi);
     window.addEventListener('orientationchange', function () {
       refreshBadgeAndUi();
       setTimeout(refreshBadgeAndUi, 140);
     });

     if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
       document.fonts.ready.then(refreshBadgeAndUi).catch(function () {});
     }

     if (typeof ResizeObserver === 'function' && canvasFrameBox) {
       try {
         const ro = new ResizeObserver(function () {
           renderBadge();
         });
         ro.observe(canvasFrameBox);
       } catch (_) {
         // Ignorer
       }
     }

     setTimeout(refreshBadgeAndUi, 120);
     setTimeout(refreshBadgeAndUi, 400);
   })();
 </script>
