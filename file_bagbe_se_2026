     function drawFancyWaveUnderline(c, centerX, startY, width, color) {
       c.save();
       const halfW = width * 0.48;
       const leftX = centerX - halfW;
       const rightX = centerX + halfW;
       const segments = 6;
       const stepW = (rightX - leftX) / segments;

       c.strokeStyle = color;
       c.lineWidth = 3.4;
       c.lineCap = 'round';
       c.lineJoin = 'round';
       c.beginPath();
       c.moveTo(leftX, startY);
       for (let i = 0; i < segments; i += 1) {
         const x0 = leftX + i * stepW;
         const xMid = x0 + stepW * 0.5;
         const x1 = x0 + stepW;
         const amp = (i % 2 === 0 ? -1 : 1) * 5.5;
         c.quadraticCurveTo(xMid, startY + amp, x1, startY);
       }
       c.stroke();

       c.lineWidth = 1.7;
       c.globalAlpha = 0.88;
       c.beginPath();
       const innerLeft = leftX + 16;
       const innerRight = rightX - 16;
       const innerSegs = segments - 1;
       const innerStep = (innerRight - innerLeft) / innerSegs;
       c.moveTo(innerLeft, startY + 7);
       for (let i = 0; i < innerSegs; i += 1) {
         const x0 = innerLeft + i * innerStep;
         const xMid = x0 + innerStep * 0.5;
         const x1 = x0 + innerStep;
         const amp = (i % 2 === 0 ? 1 : -1) * 3.5;
         c.quadraticCurveTo(xMid, startY + 7 + amp, x1, startY + 7);
       }
       c.stroke();

       c.globalAlpha = 1;
       c.fillStyle = color;
       const drawDiamond = function (dx, dy) {
         c.beginPath();
         c.moveTo(dx, dy - 4.4);
         c.lineTo(dx + 4.4, dy);
         c.lineTo(dx, dy + 4.4);
         c.lineTo(dx - 4.4, dy);
         c.closePath();
         c.fill();
       };
       drawDiamond(leftX - 10, startY);
       drawDiamond(rightX + 10, startY);
       c.restore();
     }

     function drawCalendarIcon(c, cx, cy, size, color) {
       c.save();
