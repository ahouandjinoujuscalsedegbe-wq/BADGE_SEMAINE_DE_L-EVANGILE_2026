<!DOCTYPE html>
<html lang="fr">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>Générateur de Badge — Semaine de l'Évangile CUA</title>
 <style>
   :root {
     --bg-page: #f1f5f9;
     --bg-card: #ffffff;
     --bg-subtle: #f8fafc;
     --text-main: #0f172a;
     --text-muted: #475569;
     --border-soft: #cbd5e1;
     --navy-pure: #0a1e47;
     --navy-arc: #122d66;
     --orange-accent: #d49a2a;
     --white-pure: #ffffff;
     --whatsapp-green: #16a34a;
     --whatsapp-hover: #15803d;
     --danger-red: #dc2626;
     --danger-bg: #fef2f2;
     --success-green: #15803d;
     --success-bg: #f0fdf4;
   }

   *,
   *::before,
   *::after {
     box-sizing: border-box;
     margin: 0;
     padding: 0;
   }

   html,
   body {
     width: 100%;
     min-height: 100%;
     background-color: var(--bg-page);
     color: var(--text-main);
     font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
     line-height: 1.5;
     overflow-x: hidden;
     -webkit-tap-highlight-color: transparent;
   }

   .app-shell {
     width: 100%;
     max-width: 1160px;
     margin: 0 auto;
     padding: 16px 14px 40px;
   }

   .app-header {
     text-align: center;
     margin-bottom: 18px;
   }

   .app-header h1 {
     font-size: clamp(1.3rem, 3.6vw, 1.95rem);
     font-weight: 800;
     color: var(--navy-pure);
     letter-spacing: -0.02em;
   }

   .main-grid {
     display: grid;
     grid-template-columns: 1fr;
     gap: 20px;
     align-items: start;
   }

   @media (min-width: 880px) {
     .main-grid {
       grid-template-columns: minmax(320px, 410px) minmax(340px, 1fr);
       gap: 24px;
     }

     .app-shell {
       padding: 24px 20px 48px;
     }
   }

   .panel {
     background: var(--bg-card);
     border: 1px solid var(--border-soft);
     border-radius: 20px;
     padding: 18px;
     box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
   }

   @media (min-width: 600px) {
     .panel {
       padding: 22px;
     }
   }

   .panel-title {
     font-size: 1.05rem;
     font-weight: 700;
     color: var(--navy-pure);
     margin-bottom: 14px;
     display: flex;
     align-items: center;
     justify-content: space-between;
     gap: 8px;
   }

   .field-block {
     margin-bottom: 16px;
     border-radius: 14px;
     transition: background-color 0.2s ease, box-shadow 0.2s ease;
   }

   .field-block.field-error {
     background-color: var(--danger-bg);
     padding: 10px;
     margin-left: -10px;
     margin-right: -10px;
     box-shadow: 0 0 0 2px var(--danger-red);
     animation: shakeField 0.35s ease;
   }

   @keyframes shakeField {
     0%, 100% { transform: translateX(0); }
     25% { transform: translateX(-5px); }
     75% { transform: translateX(5px); }
   }

   .field-label {
     display: block;
     font-size: 0.9rem;
     font-weight: 700;
     color: var(--text-main);
     margin-bottom: 6px;
   }

   .req-star {
     color: var(--danger-red);
     font-weight: 800;
   }

   .text-input {
     width: 100%;
     padding: 12px 14px;
     font-size: 1rem;
     font-weight: 600;
     color: var(--text-main);
     background: var(--bg-subtle);
     border: 1.5px solid var(--border-soft);
     border-radius: 12px;
     outline: none;
     transition: border-color 0.2s ease, background-color 0.2s ease;
   }

   .text-input:focus {
     border-color: var(--navy-pure);
     background: var(--white-pure);
     box-shadow: 0 0 0 3px rgba(10, 30, 71, 0.12);
   }

   .text-input.input-invalid {
     border-color: var(--danger-red);
     background: var(--white-pure);
   }

   .upload-dropzone {
     position: relative;
     display: flex;
     flex-direction: column;
     align-items: center;
     justify-content: center;
     gap: 6px;
     width: 100%;
     min-height: 104px;
     padding: 14px;
     border: 2px dashed #94a3b8;
     border-radius: 14px;
     background: var(--bg-subtle);
     cursor: pointer;
     text-align: center;
     transition: border-color 0.2s ease, background-color 0.2s ease;
   }

   .upload-dropzone:hover,
   .upload-dropzone.dragover {
     border-color: var(--navy-pure);
     background: #eff6ff;
   }

   .upload-dropzone.invalid-zone {
     border-color: var(--danger-red);
     background: var(--white-pure);
   }

   .upload-dropzone input[type="file"] {
     position: absolute;
     inset: 0;
     width: 100%;
     height: 100%;
     opacity: 0;
     cursor: pointer;
   }

   .upload-main-text {
     font-size: 0.9rem;
     font-weight: 700;
     color: var(--navy-pure);
   }

   .upload-sub-text {
     font-size: 0.78rem;
     color: var(--text-muted);
   }

   .photo-status-row {
     margin-top: 8px;
     display: none;
     align-items: center;
     justify-content: space-between;
     gap: 8px;
     font-size: 0.8rem;
     color: var(--success-green);
     font-weight: 600;
   }

   .photo-status-row.visible {
     display: flex;
   }

   .clear-photo-btn {
     padding: 5px 10px;
     font-size: 0.76rem;
     font-weight: 700;
     color: var(--danger-red);
     background: var(--danger-bg);
     border: 1px solid #fecaca;
     border-radius: 8px;
     cursor: pointer;
   }

   .clear-photo-btn:hover {
     background: #fee2e2;
   }

   .status-banner {
     padding: 11px 13px;
     border-radius: 12px;
     font-size: 0.84rem;
     font-weight: 600;
     margin-bottom: 14px;
     border: 1px solid transparent;
   }

   .status-banner.locked {
     background: #fffbeb;
     color: #92400e;
     border-color: #fde68a;
   }

   .status-banner.error {
     background: var(--danger-bg);
     color: #991b1b;
     border-color: #fca5a5;
   }

   .status-banner.ready {
     background: var(--success-bg);
     color: var(--success-green);
     border-color: #86efac;
   }

   .actions-stack {
     display: flex;
     flex-direction: column;
     gap: 10px;
   }

   .btn-action {
     width: 100%;
     padding: 13px 16px;
     font-size: 0.95rem;
     font-weight: 700;
     border: none;
     border-radius: 13px;
     cursor: pointer;
     display: flex;
     align-items: center;
     justify-content: center;
     gap: 8px;
     transition: transform 0.12s ease, opacity 0.2s ease, background-color 0.2s ease;
   }

   .btn-action:active:not(:disabled) {
     transform: scale(0.985);
   }

   .btn-action:disabled {
     opacity: 0.55;
     cursor: not-allowed;
   }

   .btn-whatsapp {
     background: var(--whatsapp-green);
     color: var(--white-pure);
     box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25);
   }

   .btn-whatsapp:hover:not(:disabled) {
     background: var(--whatsapp-hover);
   }

   .btn-download {
     background: var(--navy-pure);
     color: var(--white-pure);
     box-shadow: 0 4px 12px rgba(10, 30, 71, 0.2);
   }

   .btn-download:hover:not(:disabled) {
     background: var(--navy-arc);
   }

   .preview-column {
     display: flex;
     flex-direction: column;
     align-items: center;
     width: 100%;
   }

   .preview-header {
     width: 100%;
     max-width: 540px;
     display: flex;
     align-items: center;
     justify-content: space-between;
     gap: 8px;
     margin-bottom: 10px;
     font-size: 0.92rem;
     font-weight: 800;
     color: var(--navy-pure);
   }

   .canvas-frame-box {
     position: relative;
     width: 100%;
     max-width: 540px;
     aspect-ratio: 1 / 1;
     border-radius: 18px;
     overflow: hidden;
     background: var(--navy-pure);
     box-shadow: 0 14px 34px rgba(10, 30, 71, 0.22);
     border: 2px solid #cbd5e1;
     touch-action: none;
     user-select: none;
     -webkit-user-select: none;
   }

   .canvas-frame-box.can-drag {
     cursor: grab;
   }

   .canvas-frame-box.is-dragging {
     cursor: grabbing;
   }

   #badgeCanvas {
     display: block;
     width: 100%;
     height: 100%;
   }

   .crop-toolbar {
     width: 100%;
     max-width: 540px;
     margin-top: 12px;
     padding: 8px 12px;
     background: var(--bg-subtle);
     border: 1px solid var(--border-soft);
     border-radius: 14px;
     display: none;
     align-items: center;
     justify-content: space-between;
     gap: 8px;
   }

   .crop-toolbar.visible {
     display: flex;
   }

   .zoom-group {
     display: inline-flex;
     align-items: center;
     gap: 6px;
   }

   .crop-btn {
     min-width: 38px;
     height: 36px;
     padding: 0 10px;
     border-radius: 10px;
     border: 1px solid var(--border-soft);
     background: var(--white-pure);
     color: var(--navy-pure);
     font-size: 1rem;
     font-weight: 800;
     cursor: pointer;
     display: inline-flex;
     align-items: center;
     justify-content: center;
     transition: background-color 0.15s ease, border-color 0.15s ease;
   }

   .crop-btn:hover {
     background: #e2e8f0;
     border-color: #94a3b8;
   }

   .crop-btn:active {
     background: #cbd5e1;
   }

   .crop-btn.reset-btn {
     font-size: 0.78rem;
     font-weight: 700;
     padding: 0 12px;
   }

   .zoom-readout {
     min-width: 54px;
     text-align: center;
     font-size: 0.85rem;
     font-weight: 800;
     color: var(--navy-pure);
     font-variant-numeric: tabular-nums;
   }

   .modal-backdrop {
     position: fixed;
     inset: 0;
     background: rgba(15, 23, 42, 0.58);
     display: none;
     align-items: center;
     justify-content: center;
     padding: 16px;
     z-index: 100;
   }

   .modal-backdrop.open {
     display: flex;
   }

   .modal-card {
     width: 100%;
     max-width: 440px;
     background: var(--white-pure);
     border-radius: 18px;
     padding: 20px;
     box-shadow: 0 20px 45px rgba(15, 23, 42, 0.28);
   }

   .modal-card h3 {
     font-size: 1.05rem;
     font-weight: 800;
     color: var(--navy-pure);
     margin-bottom: 8px;
   }

   .modal-card p {
     font-size: 0.86rem;
     color: var(--text-muted);
     margin-bottom: 12px;
   }

   .caption-box {
     width: 100%;
     min-height: 104px;
     padding: 10px;
     font-size: 0.82rem;
     font-family: inherit;
     color: var(--text-main);
     background: var(--bg-subtle);
     border: 1px solid var(--border-soft);
     border-radius: 10px;
     resize: vertical;
     margin-bottom: 12px;
   }

   .modal-actions {
     display: flex;
     flex-wrap: wrap;
     gap: 8px;
     justify-content: flex-end;
   }

   .modal-btn {
     padding: 9px 14px;
     border-radius: 10px;
     font-size: 0.84rem;
     font-weight: 700;
     border: 1px solid var(--border-soft);
     background: var(--white-pure);
     color: var(--text-main);
     cursor: pointer;
   }

   .modal-btn.primary {
     background: var(--whatsapp-green);
     color: var(--white-pure);
     border-color: var(--whatsapp-green);
   }
 </style>
</head>
<body>
 <main class="app-shell">
   <header class="app-header">
     <h1>Générateur de Badge — Semaine de l'Évangile</h1>
   </header>

   <div class="main-grid">
     <section class="panel" aria-label="Formulaire de personnalisation">
       <div class="panel-title">
         <span>Vos informations</span>
         <span style="font-size:0.76rem;color:#64748b;font-weight:600;">* Obligatoires</span>
       </div>

       <div id="nameBlock" class="field-block">
         <label for="fullNameInput" class="field-label">
           Nom & Prénom <span class="req-star">*</span>
         </label>
         <input
           id="fullNameInput"
           type="text"
           class="text-input"
           placeholder="Ex. : Jean-Marc KOUASSI"
           maxlength="44"
           autocomplete="name"
         />
       </div>

       <div id="photoBlock" class="field-block">
         <label for="photoFileInput" class="field-label">
           Votre photo <span class="req-star">*</span>
         </label>
         <div id="dropzone" class="upload-dropzone">
           <input
             id="photoFileInput"
             type="file"
             accept="image/jpeg,image/png,image/webp,image/heic,image/*"
           />
           <span class="upload-main-text">Choisir ou déposer une photo</span>
           <span class="upload-sub-text">JPG, PNG ou WEBP</span>
         </div>
         <div id="photoStatusRow" class="photo-status-row">
           <span id="photoFileName">Photo chargée</span>
           <button type="button" id="clearPhotoBtn" class="clear-photo-btn">Retirer</button>
         </div>
       </div>

       <div id="statusBanner" class="status-banner locked" role="status" aria-live="polite">
         Veuillez renseigner votre nom complet et importer votre photo pour débloquer le badge.
       </div>

       <div class="actions-stack">
         <button type="button" id="whatsappShareBtn" class="btn-action btn-whatsapp">
           <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
             <circle cx="18" cy="5" r="3"></circle>
             <circle cx="6" cy="12" r="3"></circle>
             <circle cx="18" cy="19" r="3"></circle>
             <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
             <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
           </svg>
           <span>Partager sur le statut WhatsApp</span>
         </button>

         <button type="button" id="downloadPngBtn" class="btn-action btn-download">
           <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
             <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
             <polyline points="7 10 12 15 17 10"></polyline>
             <line x1="12" y1="15" x2="12" y2="3"></line>
           </svg>
           <span>Télécharger PNG (1080 × 1080)</span>
         </button>
       </div>
     </section>

     <section class="preview-column" aria-label="Aperçu du badge">
       <div class="preview-header">
         <span>Aperçu du badge</span>
       </div>

       <div id="canvasFrameBox" class="canvas-frame-box">
         <!-- Tampon interne 2x suréchantillonné (2160 x 2160 px) mappé en coordonnées logiques 1080 x 1080 px -->
         <canvas id="badgeCanvas" width="2160" height="2160"></canvas>
       </div>

       <div id="cropToolbar" class="crop-toolbar" aria-label="Outils de zoom et recentrage photo">
         <div class="zoom-group">
           <button type="button" id="zoomOutBtn" class="crop-btn" title="Dézoomer" aria-label="Dézoomer">−</button>
           <span id="zoomReadout" class="zoom-readout">100%</span>
           <button type="button" id="zoomInBtn" class="crop-btn" title="Zoomer" aria-label="Zoomer">+</button>
         </div>
         <button type="button" id="resetCropBtn" class="crop-btn reset-btn">Recentrer</button>
       </div>
     </section>
   </div>
 </main>

 <div id="whatsappModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
   <div class="modal-card">
     <h3 id="modalTitle">Publier sur votre statut WhatsApp</h3>
     <p id="modalDescription">
       Votre badge PNG 1080×1080 px a été préparé. Copiez la légende ci-dessous, ouvrez WhatsApp, puis sélectionnez l'image pour l'ajouter à votre Statut.
     </p>
     <textarea id="whatsappCaptionBox" class="caption-box" readonly></textarea>
     <div class="modal-actions">
       <button type="button" id="copyCaptionBtn" class="modal-btn">Copier le texte</button>
       <a id="openWhatsAppLink" href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="modal-btn primary" style="text-decoration:none;">
         Ouvrir WhatsApp
       </a>
       <button type="button" id="closeModalBtn" class="modal-btn">Fermer</button>
     </div>
   </div>
 </div>

 <script>
   (function () {
     'use strict';

     // Système de coordonnées logiques 1080 x 1080 px rendu sur un tampon 2x (2160 x 2160 px)
     const LOGICAL_SIZE = 1080;
     const SUPERSAMPLE_SCALE = 2;
     const TARGET_INTERNAL_SIZE = LOGICAL_SIZE * SUPERSAMPLE_SCALE;

     // Palette officielle : bleu nuit pur (#0A1E47) et orange doré (#D49A2A)
     const NAVY_PURE = '#0a1e47';
     const NAVY_ARC = '#122d66';
     const ORANGE_ACCENT = '#d49a2a';
     const WHITE_PURE = '#ffffff';

     // Couleurs fidèles de l'emblème CUA sans déformation
     const LOGO_CUA_BLUE = '#1d3f8a';
     const LOGO_BOOK_GREY = '#9aa4b2';
     const LOGO_BOOK_GOLD = '#dfb03a';
     const LOGO_SUBTITLE_SLATE = '#33435c';

     // Cadre photo carré arrondi (450 x 450 px) à gauche
     const PHOTO_BOX = Object.freeze({
       x: 52,
       y: 298,
       size: 450,
       radius: 34
     });

     const ZOOM_MIN = 0.5;
     const ZOOM_MAX = 3.5;
     const ZOOM_STEP = 0.12;

     // Textes exacts et inchangés du badge
     const BADGE_COPY = Object.freeze({
       logoCode: 'CUA',
       logoFullName: 'CENTRE UNIVERSITAIRE APOSTOLIQUE',
       pill: "SEMAINE DE L'ÉVANGILE",
       headline: "J'Y SERAI !",
       sublineLine1: 'POUR PRÊCHER ET GAGNER',
       sublineLine2: 'DES ÂMES À CHRIST',
       placeholderName: 'VOTRE NOM & PRÉNOM',
       verseQuote: '« Allez par tout le monde, et prêchez la bonne nouvelle à toute la création. »',
       verseRef: '— MARC 16 : 15',
       dateText: 'Du Lundi 30 Novembre au Samedi 05 Décembre 2026',
       placeText: 'Campus UAC',
       timeText: 'Départ 16h45 • Ensemble pour Christ',
       bottomFooter: 'GAGNER DES ÂMES • ENSEMBLE POUR CHRIST'
     });

     const INCOMPLETE_STATUS_MSG = 'Veuillez renseigner votre nom complet et importer votre photo pour débloquer le badge.';
     const NAME_ERROR_MSG = 'Veuillez renseigner votre nom complet (au moins 2 caractères) et importer votre photo.';
     const PHOTO_ERROR_MSG = 'Veuillez importer votre photo pour débloquer le badge.';
     const BOTH_ERROR_MSG = 'Veuillez renseigner votre nom complet et importer votre photo.';

     const canvas = document.getElementById('badgeCanvas');
     const canvasFrameBox = document.getElementById('canvasFrameBox');
     const fullNameInput = document.getElementById('fullNameInput');
     const nameBlock = document.getElementById('nameBlock');
     const photoFileInput = document.getElementById('photoFileInput');
     const photoBlock = document.getElementById('photoBlock');
     const dropzone = document.getElementById('dropzone');
     const photoStatusRow = document.getElementById('photoStatusRow');
     const photoFileName = document.getElementById('photoFileName');
     const clearPhotoBtn = document.getElementById('clearPhotoBtn');
     const statusBanner = document.getElementById('statusBanner');
     const whatsappShareBtn = document.getElementById('whatsappShareBtn');
     const downloadPngBtn = document.getElementById('downloadPngBtn');
     const cropToolbar = document.getElementById('cropToolbar');
     const zoomOutBtn = document.getElementById('zoomOutBtn');
     const zoomInBtn = document.getElementById('zoomInBtn');
     const zoomReadout = document.getElementById('zoomReadout');
     const resetCropBtn = document.getElementById('resetCropBtn');
     const whatsappModal = document.getElementById('whatsappModal');
     const whatsappCaptionBox = document.getElementById('whatsappCaptionBox');
     const copyCaptionBtn = document.getElementById('copyCaptionBtn');
     const closeModalBtn = document.getElementById('closeModalBtn');

     const state = {
       fullName: '',
       photoImg: null,
       photoLoaded: false,
       zoom: 1,
       offsetX: 0,
       offsetY: 0,
       dragging: false,
       dragStartX: 0,
       dragStartY: 0,
       pinchStartDist: 0,
       pinchStartZoom: 1,
       holdTimer: null,
       holdInterval: null,
       hasValidationAttempt: false,
       customStatusError: ''
     };

     function clamp(val, min, max) {
       return Math.max(min, Math.min(max, val));
     }

     function getCleanName() {
       return (state.fullName || '').trim().replace(/\s+/g, ' ');
     }

     function isNameValid() {
       return getCleanName().length >= 2;
     }

     function isPhotoValid() {
       return Boolean(state.photoLoaded && state.photoImg);
     }

     function isFormComplete() {
       return isNameValid() && isPhotoValid();
     }

     function updateZoomReadout() {
       if (zoomReadout) {
         zoomReadout.textContent = `${Math.round(state.zoom * 100)}%`;
       }
     }

     function syncUiState() {
       try {
         const complete = isFormComplete();
         const nameOk = isNameValid();
         const photoOk = isPhotoValid();

         if (whatsappShareBtn) {
           whatsappShareBtn.disabled = !complete;
           whatsappShareBtn.setAttribute('aria-disabled', String(!complete));
         }
         if (downloadPngBtn) {
           downloadPngBtn.disabled = !complete;
           downloadPngBtn.setAttribute('aria-disabled', String(!complete));
         }

         if (cropToolbar) {
           cropToolbar.classList.toggle('visible', photoOk);
         }
         if (canvasFrameBox) {
           canvasFrameBox.classList.toggle('can-drag', photoOk);
         }

         updateZoomReadout();

         const showNameErr = state.hasValidationAttempt && !nameOk;
         const showPhotoErr = state.hasValidationAttempt && !photoOk;

         if (nameBlock) nameBlock.classList.toggle('field-error', showNameErr);
         if (fullNameInput) fullNameInput.classList.toggle('input-invalid', showNameErr);
         if (photoBlock) photoBlock.classList.toggle('field-error', showPhotoErr);
         if (dropzone) dropzone.classList.toggle('invalid-zone', showPhotoErr);

         if (!statusBanner) return;
         statusBanner.classList.remove('locked', 'error', 'ready');

         if (state.customStatusError) {
           statusBanner.classList.add('error');
           statusBanner.textContent = state.customStatusError;
           return;
         }

         if (complete) {
           statusBanner.classList.add('ready');
           statusBanner.textContent = 'Badge prêt pour le téléchargement PNG et le statut WhatsApp.';
           return;
         }

         if (state.hasValidationAttempt) {
           statusBanner.classList.add('error');
           if (!nameOk && !photoOk) {
             statusBanner.textContent = BOTH_ERROR_MSG;
           } else if (!nameOk) {
             statusBanner.textContent = NAME_ERROR_MSG;
           } else {
             statusBanner.textContent = PHOTO_ERROR_MSG;
           }
           return;
         }

         statusBanner.classList.add('locked');
         statusBanner.textContent = INCOMPLETE_STATUS_MSG;
       } catch (_) {
         // Ne jamais bloquer le rendu si une mise à jour DOM échoue
       }
     }

     function validateMandatoryFields() {
       state.hasValidationAttempt = true;
       state.customStatusError = '';
       syncUiState();

       if (isFormComplete()) {
         return true;
       }

       let targetEl = null;
       if (!isNameValid()) {
         targetEl = fullNameInput || nameBlock;
       } else if (!isPhotoValid()) {
         targetEl = photoBlock || dropzone;
       }

       if (targetEl && typeof targetEl.scrollIntoView === 'function') {
         try {
           targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
         } catch (_) {
           try {
             targetEl.scrollIntoView();
           } catch (__) {
             // Ignorer
           }
         }
       }
       return false;
     }

     function traceRoundedRect(c, x, y, w, h, r) {
       const radius = Math.max(0, Math.min(r, w / 2, h / 2));
       c.beginPath();
       if (typeof c.roundRect === 'function') {
         c.roundRect(x, y, w, h, radius);
       } else {
         c.moveTo(x + radius, y);
         c.arcTo(x + w, y, x + w, y + h, radius);
         c.arcTo(x + w, y + h, x, y + h, radius);
         c.arcTo(x, y + h, x, y, radius);
         c.arcTo(x, y, x + w, y, radius);
         c.closePath();
       }
     }

